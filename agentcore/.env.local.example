# Copy to agentcore/.env.local for local AgentCore CLI development.
# This project uses Amazon Bedrock through the AWS credential chain; do not
# store AWS access keys here. Select an AWS profile outside this file.

BEDROCK_REGION=ap-southeast-1
# Set to a model available in your selected AWS Region and account.
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5

# Set this to the externally reachable AgentCore A2A invocation URL after deploy.
# A2A_PUBLIC_URL=https://your-agentcore-runtime-a2a-url

# Demo only: the current A2A adapter maps all requests to this one principal.
# Do not use this identity mechanism for production or multi-user access.
# A2A_DEMO_BEARER_TOKEN=replace-with-local-demo-token
