                                                                     ]
                                                    }
                                       },
                                       {
                                           "if":  {
                                                      "properties":  {
                                                                         "status":  {
                                                                                        "enum":  [
                                                                                                     "Reject"
                                                                                                 ]
                                                                                    }
                                                                     },
