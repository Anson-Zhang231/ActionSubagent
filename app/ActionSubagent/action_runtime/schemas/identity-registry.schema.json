{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-action-agent-platform.local/schemas/identity-registry.schema.json",
  "title": "Identity Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["permissions", "roles", "users"],
  "properties": {
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/permission"}
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/role"}
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/user"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "status", "application_ids", "capability_ids", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "INACTIVE"]},
        "application_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "capability_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "status", "permission_ids", "data_scope", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "INACTIVE"]},
        "permission_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_scope": {"enum": ["SELF", "DEPARTMENT", "ORGANIZATION", "ALL"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "external_subject_id", "display_name", "email", "status", "role_ids", "organization_id", "department_id", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "external_subject_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "email": {"type": ["string", "null"], "format": "email"},
        "status": {"enum": ["ACTIVE", "INACTIVE"]},
        "role_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "organization_id": {"$ref": "#/$defs/id"},
        "department_id": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
