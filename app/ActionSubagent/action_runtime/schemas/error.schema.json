{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-action-agent-platform:schema:error:1.0.0",
  "title": "Standard Action Error",
  "description": "Defines the canonical error format shared by Action Runtime contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "stage", "retryable", "details", "occurred_at"],
  "properties": {
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "message": {"type": "string", "minLength": 1},
    "stage": {
      "type": "string",
      "enum": ["UNDERSTAND", "DISCOVER_CAPABILITY", "COLLECT_DATA", "VALIDATE", "AUTHORIZE", "CONFIRM", "EXECUTE", "VERIFY", "AUDIT"]
    },
    "retryable": {"type": "boolean"},
    "details": {"type": "object"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
